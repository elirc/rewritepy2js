datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @map("name")
  email     String    @unique
  password  String
  bio       String?
  image     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  articles  Article[] @relation("UserArticles")
  comments  Comment[] @relation("UserComments")
  favorites Article[] @relation("UserFavorites")

  // Self-referential relationship for following/followers
  followers User[]    @relation("UserFollows")
  following User[]    @relation("UserFollows")

  @@map("users")
}

model Article {
  id          Int       @id @default(autoincrement())
  authorId    Int       @map("author_id")
  title       String
  slug        String    @unique
  description String
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author      User      @relation("UserArticles", fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[] @relation("ArticleComments")
  favoritedBy User[]    @relation("UserFavorites")
  tags        Tag[]     @relation("ArticleTags")

  @@map("articles")
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[] @relation("ArticleTags")

  @@map("tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  authorId  Int      @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article   Article  @relation("ArticleComments", fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}
